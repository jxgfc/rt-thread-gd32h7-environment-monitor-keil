import os
import rtconfig
from building import *

cwd = GetCurrentDir()

# add general drivers
src = Split('''
board.c
''')

if GetDepend('BSP_USING_TLI_LCD'):
    src += ['drv_tli_lcd.c']

if GetDepend('BSP_USING_GT911_TOUCH'):
    src += ['drv_gt911.c']

if GetDepend('BSP_USING_SENSOR_SERVICE'):
    src += ['sensor_service.c']

if GetDepend('BSP_USING_RTC'):
    src += ['drv_rtc.c']

if GetDepend('BSP_USING_SD_CARD'):
    src += ['sdcard.c', 'drv_sdcard.c']

path =  [cwd]

CPPDEFINES = ['GD32H7XX']
group = DefineGroup('Drivers', src, depend = [''], CPPPATH = path, CPPDEFINES = CPPDEFINES)

Return('group')
